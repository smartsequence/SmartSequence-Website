---
import Layout from '../layouts/Layout.astro';
import { STUDIO_TAX_ID, CONTACT_EMAIL } from '../consts';
import { getLangFromUrl, getTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);

function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}

const markets = ['m1','m2','m3','m4','m5'];
const marketFlags = ['🇹🇼','🇯🇵','🇺🇸','🇩🇪','🌐'];

const philosophyItems = [
	{ key: 'p1', icon: '📊' },
	{ key: 'p2', icon: '🔒' },
	{ key: 'p3', icon: '🌏' },
];
---

<Layout title={t('pages.about.title')} description={t('pages.about.description')}>
	<!-- Hero -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-eyebrow">
				<a href={getLocalizedPath('/', lang)}>{t('common.studioCrumb')}</a>
				<span>›</span>
				<span>{t('nav.about')}</span>
			</div>
			<h1>{t('pages.about.heroTitle')}</h1>
			<p class="hero-sub">{t('pages.about.heroSubtitle')}</p>
		</div>
	</section>

	<!-- Mission -->
	<section class="section mission-section">
		<div class="container">
			<div class="mission-box">
				<div class="mission-label">{t('pages.about.missionTitle')}</div>
				<blockquote>"{t('pages.about.missionText')}"</blockquote>
			</div>
		</div>
	</section>

	<!-- Philosophy -->
	<section class="section philosophy-section">
		<div class="container">
			<h2 class="section-title">{t('pages.about.philosophyTitle')}</h2>
			<div class="philosophy-grid">
				{philosophyItems.map(({ key, icon }) => (
					<div class="philosophy-card">
						<div class="philosophy-icon">{icon}</div>
						<h3>{t(`pages.about.${key}Title`)}</h3>
						<p>{t(`pages.about.${key}Text`)}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Markets -->
	<section class="section markets-section">
		<div class="container">
			<h2 class="section-title">{t('pages.about.marketsTitle')}</h2>
			<div class="markets-grid">
				{markets.map((m, i) => (
					<div class="market-card">
						<span class="market-flag">{marketFlags[i]}</span>
						<span class="market-name">{t(`pages.about.${m}`)}</span>
					</div>
				))}
			</div>
			<p class="markets-note">{t('pages.about.marketsNote')}</p>
		</div>
	</section>

	<!-- Delivery model -->
	<section class="section delivery-section">
		<div class="container">
			<h2 class="section-title">{t('pages.about.deliveryTitle')}</h2>
			<div class="delivery-grid">
				{['d1', 'd2', 'd3'].map((key) => (
					<div class="delivery-card">
						<h3>{t(`pages.about.${key}Title`)}</h3>
						<p>{t(`pages.about.${key}Text`)}</p>
					</div>
				))}
			</div>
			<p class="delivery-note">{t('pages.about.deliveryNote')}</p>
			<p class="delivery-link"><a href={getLocalizedPath('/services', lang)}>{t('pages.about.deliveryLink')}</a></p>
		</div>
	</section>

	<!-- Company Info (low visual weight) -->
	<section class="section company-section">
		<div class="container">
			<div class="company-box">
				<h2>{t('pages.about.companyTitle')}</h2>
				<dl class="company-dl">
					<dt>{t('pages.about.entityLabel')}</dt>
					<dd>{t('pages.about.companyName')}</dd>
					<dt>{t('pages.about.taxIdLabel')}</dt>
					<dd>{STUDIO_TAX_ID}</dd>
					<dt>{t('pages.about.contactLabel')}</dt>
					<dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd>
				</dl>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container">
			<div class="cta-box">
				<h2>{t('pages.about.ctaTitle')}</h2>
				<a href={getLocalizedPath('/contact', lang)} class="btn btn-primary">
					{t('pages.about.ctaButton')}
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-hero {
		padding: 8rem 0 4rem;
		background: var(--bg-main);
		border-bottom: 1px solid var(--border-light);
	}

	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-secondary);
		margin-bottom: 1.25rem;
	}

	.hero-eyebrow a { color: var(--accent); text-decoration: none; font-weight: 600; }

	.page-hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text-primary);
		margin-bottom: 1rem;
		max-width: 700px;
	}

	.hero-sub {
		font-size: 1.0625rem;
		color: var(--text-secondary);
		line-height: 1.7;
		max-width: 680px;
	}

	.container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
	.section { padding: 5rem 0; }

	.section-title {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 700;
		color: var(--text-primary);
		text-align: center;
		margin-bottom: 3rem;
		letter-spacing: -0.02em;
	}

	/* Mission */
	.mission-section {
		background: var(--bg-section);
		border-bottom: 1px solid var(--border-light);
	}

	.mission-box {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.mission-label {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent);
		margin-bottom: 1.5rem;
	}

	blockquote {
		font-size: clamp(1.375rem, 2.5vw, 1.875rem);
		font-weight: 600;
		color: var(--text-primary);
		line-height: 1.45;
		letter-spacing: -0.01em;
		font-style: italic;
		border: none;
		padding: 0;
		margin: 0;
	}

	/* Delivery model */
	.delivery-section {
		background: var(--bg-section);
		border-bottom: 1px solid var(--border-light);
	}

	.delivery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.delivery-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-left: 3px solid var(--cta-primary);
		border-radius: 0.75rem;
		padding: 1.75rem;
	}

	.delivery-card h3 {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.75rem;
	}

	.delivery-card p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.75;
		margin: 0;
	}

	.delivery-link {
		margin: 0.75rem 0 0;
		text-align: center;
		font-size: 0.9rem;
	}

	.delivery-link a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
	}

	.delivery-note {
		margin: 2rem auto 0;
		max-width: 760px;
		text-align: center;
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.8;
	}

	@media (max-width: 900px) {
		.delivery-grid { grid-template-columns: 1fr; }
	}

	/* Philosophy */
	.philosophy-section { border-bottom: 1px solid var(--border-light); }

	.philosophy-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.philosophy-card {
		padding: 2.5rem 2rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
	}

	.philosophy-icon {
		font-size: 2.5rem;
		margin-bottom: 1.25rem;
	}

	.philosophy-card h3 {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.75rem;
	}

	.philosophy-card p {
		font-size: 0.9375rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	/* Markets */
	.markets-section {
		background: var(--bg-section);
		border-bottom: 1px solid var(--border-light);
	}

	.markets-grid {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-bottom: 2rem;
	}

	.market-card {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.875rem 1.75rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		transition: all 0.2s;
	}

	.market-card:hover {
		border-color: #3b82f6;
		background: rgba(59,130,246,0.05);
	}

	.market-flag { font-size: 1.5rem; }
	.market-name { font-size: 1rem; }

	.markets-note {
		text-align: center;
		font-size: 0.875rem;
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.65;
	}

	/* Company (low visual weight) */
	.company-section {
		padding: 3rem 0;
		border-bottom: 1px solid var(--border-light);
	}

	.company-box {
		max-width: 480px;
	}

	.company-box h2 {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 1.25rem;
	}

	.company-dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.5rem 1.5rem;
		align-items: baseline;
	}

	dt {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		white-space: nowrap;
	}

	dd {
		font-size: 0.9rem;
		color: var(--text-primary);
		margin: 0;
	}

	dd a { color: var(--accent); text-decoration: none; }
	dd a:hover { text-decoration: underline; }

	/* CTA */
	.cta-section .cta-box {
		text-align: center;
		padding: 4rem 2rem;
		background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(16,185,129,0.05));
		border: 1px solid rgba(59,130,246,0.3);
		border-radius: 1.5rem;
	}

	.cta-section h2 {
		font-size: 2rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 2rem;
		letter-spacing: -0.02em;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.875rem 2rem;
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
		transition: all 0.2s;
	}

	.btn-primary { background: var(--cta-primary); color: white; }
	.btn-primary:hover { background: var(--cta-hover); transform: translateY(-2px); }

	@media (max-width: 768px) {
		.page-hero { padding: 6rem 0 3rem; }
		.philosophy-grid { grid-template-columns: 1fr; }
		.markets-grid { justify-content: flex-start; }
	}
</style>
