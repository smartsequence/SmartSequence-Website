---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, getTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);

function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}

const industries = [
	{
		key: 'i1',
		icon: '🏦',
		color: '#f59e0b',
		frameworks: ['PCI-DSS', 'SOX', 'DORA', 'ISO 27001', 'SWIFT CSP'],
	},
	{
		key: 'i2',
		icon: '🏛️',
		color: '#3b82f6',
		frameworks: ['CMMC 2.0', 'ISMAP', 'TW-PDPA', 'NIST CSF', 'ISO 27001'],
	},
	{
		key: 'i3',
		icon: '🏥',
		color: '#10b981',
		frameworks: ['HIPAA', 'GDPR', 'ISO 27001', 'HITRUST', 'SOC 2'],
	},
	{
		key: 'i4',
		icon: '🏭',
		color: '#8b5cf6',
		frameworks: ['ISO 27001', 'IEC 62443', 'SLSA', 'CMMC 2.0', 'SBOM (NTIA)'],
	},
];

function uc(key: string, field: string): string {
	return t(`pages.useCases.${key}.${field}`);
}
---

<Layout title={t('pages.useCases.title')} description={t('pages.useCases.description')}>
	<!-- Hero -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-eyebrow">
				<a href={getLocalizedPath('/', lang)}>ForgeHelm</a>
				<span>›</span>
				<span>{t('nav.useCases')}</span>
			</div>
			<h1>{t('pages.useCases.heroTitle')}</h1>
			<p class="hero-sub">{t('pages.useCases.heroSubtitle')}</p>
		</div>
	</section>

	<!-- Industry Cases -->
	<section class="section cases-section">
		<div class="container">
			{industries.map(({ key, icon, color, frameworks }) => (
				<div class="industry-block" style={`--ind-color: ${color};`}>
					<div class="industry-header">
						<span class="industry-icon">{icon}</span>
						<div>
							<h2>{uc(key, 'title')}</h2>
							<p class="industry-subtitle">{uc(key, 'subtitle')}</p>
						</div>
					</div>

					<div class="industry-body">
						<div class="challenge-col">
							<h3>{t('pages.useCases.challengesTitle')}</h3>
							<ul>
								{[1, 2, 3, 4].map((n) => (
									<li>
										<span class="bullet-icon">⚠</span>
										{uc(key, `c${n}`)}
									</li>
								))}
							</ul>
						</div>

						<div class="helps-col">
							<h3>{t('pages.useCases.helpsTitle')}</h3>
							<ul>
								{[1, 2, 3, 4].map((n) => (
									<li>
										<span class="bullet-icon check">✓</span>
										{uc(key, `h${n}`)}
									</li>
								))}
							</ul>
						</div>
					</div>

					<div class="industry-frameworks">
						<span class="fw-label">{t('pages.useCases.frameworksLabel')}</span>
						{frameworks.map((fw) => (
							<span class="fw-pill">{fw}</span>
						))}
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container">
			<div class="cta-box">
				<h2>{t('pages.useCases.ctaTitle')}</h2>
				<div class="cta-btns">
					<a href={getLocalizedPath('/contact', lang)} class="btn btn-primary">{t('pages.useCases.ctaButton')}</a>
					<a href={getLocalizedPath('/pricing', lang)} class="btn btn-secondary">{t('pages.useCases.ctaSecondary')}</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-hero {
		padding: 4rem 0 3rem;
		text-align: center;
	}
	.hero-eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--text-muted);
		margin-bottom: 1rem;
	}
	.hero-eyebrow a {
		color: var(--accent);
		text-decoration: none;
	}
	.hero-sub {
		max-width: 640px;
		margin: 1rem auto 0;
		color: var(--text-muted);
		font-size: 1.125rem;
		line-height: 1.7;
	}
	.cases-section {
		padding: 2rem 0 4rem;
	}
	.industry-block {
		background: var(--card-bg);
		border: 1px solid var(--border);
		border-radius: 1rem;
		padding: 2rem;
		margin-bottom: 2rem;
		border-left: 4px solid var(--ind-color);
	}
	.industry-header {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		margin-bottom: 1.5rem;
	}
	.industry-icon {
		font-size: 2.5rem;
		line-height: 1;
	}
	.industry-header h2 {
		margin: 0 0 0.25rem;
		font-size: 1.5rem;
	}
	.industry-subtitle {
		margin: 0;
		color: var(--text-muted);
	}
	.industry-body {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}
	@media (max-width: 768px) {
		.industry-body {
			grid-template-columns: 1fr;
		}
	}
	.industry-body h3 {
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted);
		margin: 0 0 1rem;
	}
	.industry-body ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.industry-body li {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	.bullet-icon {
		flex-shrink: 0;
		color: #f59e0b;
	}
	.bullet-icon.check {
		color: #10b981;
	}
	.industry-frameworks {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}
	.fw-label {
		font-size: 0.8125rem;
		color: var(--text-muted);
		margin-right: 0.25rem;
	}
	.fw-pill {
		font-size: 0.75rem;
		padding: 0.25rem 0.625rem;
		background: rgba(59, 130, 246, 0.1);
		color: var(--accent);
		border-radius: 999px;
	}
	.cta-section {
		padding: 2rem 0 4rem;
	}
	.cta-box {
		text-align: center;
		padding: 3rem 2rem;
		background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(139, 92, 246, 0.08));
		border: 1px solid var(--border);
		border-radius: 1rem;
	}
	.cta-box h2 {
		margin: 0 0 1.5rem;
	}
	.cta-btns {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}
</style>
