---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, getTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);

function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}

// Per SUBSCRIPTION_PRICING_WHITEPAPER — PlanPricingTable aligned
const plans = [
	{
		key: 'Core',
		nameKey: 'planCore',
		descKey: 'planCoreDesc',
		tagKey: 'planCoreTag',
		usd: 39,
		twd: 1250,
		jpy: 5850,
		eur: 36,
		cny: 280,
		featured: false,
		cta: 'tryNow',
		ctaHref: getLocalizedPath('/get-started', lang),
		platformFee: null,
		featureKeys: ['planCoreF1', 'planCoreF2', 'planCoreF3', 'planCoreF4', 'planCoreF5', 'planCoreF6'],
		notIncludedKeys: ['planCoreN1', 'planCoreN2', 'planCoreN3'],
	},
	{
		key: 'Professional',
		nameKey: 'planPro',
		descKey: 'planProDesc',
		tagKey: 'planProTag',
		usd: 69,
		twd: 2200,
		jpy: 10350,
		eur: 64,
		cny: 500,
		featured: true,
		cta: 'requestDemo',
		ctaHref: getLocalizedPath('/contact', lang),
		platformFee: { usd: 6000, twd: 192000, jpy: 900000, eur: 5580, cny: 43500 },
		featureKeys: ['planProF1', 'planProF2', 'planProF3', 'planProF4', 'planProF5', 'planProF6'],
		notIncludedKeys: [],
	},
	{
		key: 'Enterprise',
		nameKey: 'planEnterprise',
		descKey: 'planEnterpriseDesc',
		tagKey: 'planEntTag',
		usd: 119,
		twd: 3800,
		jpy: 17850,
		eur: 110,
		cny: 860,
		featured: false,
		cta: 'contactSales',
		ctaHref: getLocalizedPath('/contact', lang),
		platformFee: { usd: 15000, twd: 480000, jpy: 2250000, eur: 13950, cny: 108000, custom: true },
		featureKeys: ['planEntF1', 'planEntF2', 'planEntF3', 'planEntF4', 'planEntF5'],
		notIncludedKeys: [],
	},
];

// 五幣別金額與產品端 ForgeHelm-Contracts/Models/Subscription/PlanPricingTable.cs 逐格一致。
// Enterprise 平台年費原本四格寫「議價」，但產品表對五幣別皆有明確數字，故照實列出。
// ⚠ 韓元刻意不列：產品 PlanPricingTable 僅支援 USD/TWD/CNY/JPY/EUR，韓文使用者以 USD
//   報價與扣款（見 ForgeHelm-SaaS/Client/src/lib/localeCurrency.ts）。此處若擅自加 KRW，
//   會造成「看到韓元報價、被扣美元」。要支援韓元須先改產品定價表。
const currencyRows = [
	{ labelKey: 'currencyUSD', core: '$39', proSeat: '$69', proPlatform: '$6,000', entSeat: '$119+', entPlatform: '$15,000+' },
	{ labelKey: 'currencyTWD', core: 'NT$1,250', proSeat: 'NT$2,200', proPlatform: 'NT$192,000', entSeat: 'NT$3,800+', entPlatform: 'NT$480,000+' },
	{ labelKey: 'currencyCNY', core: '¥280', proSeat: '¥500', proPlatform: '¥43,500', entSeat: '¥860+', entPlatform: '¥108,000+' },
	{ labelKey: 'currencyJPY', core: '¥5,850', proSeat: '¥10,350', proPlatform: '¥900,000', entSeat: '¥17,850+', entPlatform: '¥2,250,000+' },
	{ labelKey: 'currencyEUR', core: '€36', proSeat: '€64', proPlatform: '€5,580', entSeat: '€110+', entPlatform: '€13,950+' },
];

const competitors = [
	{ product: 'compGHAS', price: 'compGHASPrice', adv: 'compGHASAdv' },
	{ product: 'compSnyk', price: 'compSnykPrice', adv: 'compSnykAdv' },
	{ product: 'compSonar', price: 'compSonarPrice', adv: 'compSonarAdv' },
	{ product: 'compVanta', price: 'compVantaPrice', adv: 'compVantaAdv' },
	{ product: 'compCheckmarx', price: 'compCheckmarxPrice', adv: 'compCheckmarxAdv' },
];

const faqs = ['faqQ1','faqQ2','faqQ3','faqQ4','faqQ5','faqQ6','faqQ7'].map(q => ({
	q: t(`pages.pricing.${q}`),
	a: t(`pages.pricing.${q.replace('Q','A')}`),
}));

---

<Layout title={t('pages.pricing.title')} description={t('pages.pricing.description')}>
	<!-- Hero -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-eyebrow">
				<a href={getLocalizedPath('/', lang)}>ForgeHelm</a>
				<span>›</span>
				<span>{t('nav.pricing')}</span>
			</div>
			<h1>{t('pages.pricing.heroTitle')}</h1>
			<p class="hero-sub">{t('pages.pricing.heroSubtitle')}</p>
			<p class="billing-note">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
				{t('pages.pricing.billedAnnually')}
			</p>
		</div>
	</section>

	<!-- Plans -->
	<section class="section plans-section">
		<div class="container">
			<div class="plans-grid">
				{plans.map(plan => (
					<div class={`plan-card ${plan.featured ? 'plan-featured' : ''}`}>
						{plan.featured && (
							<div class="plan-popular-badge">{t('pages.pricing.mostPopular')}</div>
						)}
						<div class="plan-header">
							<span class="plan-tag">{t(`pages.pricing.${plan.tagKey}`)}</span>
							<h2>{t(`pages.pricing.${plan.nameKey}`)}</h2>
							<p class="plan-desc">{t(`pages.pricing.${plan.descKey}`)}</p>
						</div>

						<div class="plan-price">
							<span class="price-main">USD ${plan.usd}{plan.key === 'Enterprise' ? '+' : ''}</span>
							<span class="price-unit">{t('pages.pricing.perSeat')}</span>
							<div class="price-alts">
								<span>TWD {plan.twd?.toLocaleString()}</span>
								<span>JPY {plan.jpy?.toLocaleString()}</span>
								<span>EUR {plan.eur}</span>
								<span>CNY {plan.cny}</span>
							</div>
							{plan.platformFee && (
								<p class="platform-fee">
									<strong>+ USD {plan.platformFee.usd?.toLocaleString()}{plan.platformFee.custom ? '+' : ''}</strong>
									{t('pages.pricing.platformFeeYear')}
									{plan.platformFee.twd && (
										<span class="platform-fee-alt"> (TWD {plan.platformFee.twd.toLocaleString()})</span>
									)}
								</p>
							)}
						</div>

						<a href={plan.ctaHref} class={`plan-btn ${plan.featured ? 'plan-btn-primary' : 'plan-btn-secondary'}`}>
							{t(`pages.pricing.${plan.cta}`)}
						</a>

						<ul class="plan-features">
							{plan.featureKeys.map((fk) => (
								<li class="feature-included">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
									{t(`pages.pricing.${fk}`)}
								</li>
							))}
							{plan.notIncludedKeys.map((fk) => (
								<li class="feature-excluded">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
									{t(`pages.pricing.${fk}`)}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Annual formula -->
	<section class="section formula-section">
		<div class="container">
			<div class="formula-box">
				<h2>{t('pages.pricing.annualFormulaTitle')}</h2>
				<p class="formula-expr">{t('pages.pricing.annualFormula')}</p>
				<p class="formula-example"><strong>{t('pages.pricing.annualExampleTitle')}:</strong> {t('pages.pricing.annualExample')}</p>
			</div>
		</div>
	</section>

	<!-- Five-currency table -->
	<section class="section currency-section">
		<div class="container">
			<h2 class="section-title">{t('pages.pricing.currencyTableTitle')}</h2>
			<div class="table-wrap">
				<table class="currency-table">
					<thead>
						<tr>
							<th>{t('pages.pricing.tableCurrency')}</th>
							<th>Core</th>
							<th>{t('pages.pricing.tableProSeat')}</th>
							<th>{t('pages.pricing.tableProPlatform')}</th>
							<th>{t('pages.pricing.tableEntSeat')}</th>
							<th>{t('pages.pricing.tableEntPlatform')}</th>
						</tr>
					</thead>
					<tbody>
						{currencyRows.map(row => (
							<tr>
								<td class="feature-col">{t(`pages.pricing.${row.labelKey}`)}</td>
								<td class="center-col">{row.core}</td>
								<td class="center-col">{row.proSeat}</td>
								<td class="center-col">{row.proPlatform}</td>
								<td class="center-col">{row.entSeat}</td>
								<td class="center-col">{row.entPlatform}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="tier-note">{t('pages.pricing.tierBasisNote')}</p>
		</div>
	</section>

	<!-- Competitor benchmark -->
	<section class="section competitor-section">
		<div class="container">
			<h2 class="section-title">{t('pages.pricing.competitorTitle')}</h2>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>{t('pages.pricing.competitorProduct')}</th>
							<th>{t('pages.pricing.competitorPrice')}</th>
							<th>{t('pages.pricing.competitorAdvantage')}</th>
						</tr>
					</thead>
					<tbody>
						{competitors.map(c => (
							<tr>
								<td class="feature-col">{t(`pages.pricing.${c.product}`)}</td>
								<td>{t(`pages.pricing.${c.price}`)}</td>
								<td>{t(`pages.pricing.${c.adv}`)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- Enterprise TCO -->
	<section class="section tco-section">
		<div class="container">
			<h2 class="section-title">{t('pages.pricing.tcoTitle')}</h2>
			<div class="tco-grid">
				<div class="tco-card tco-forgehelm">
					<h3>{t('pages.pricing.tcoForgeHelm')}</h3>
					<ul>
						<li>{t('pages.pricing.tcoForgeHelmSub')}</li>
						<li>{t('pages.pricing.tcoForgeHelmGpu')}</li>
						<li>{t('pages.pricing.tcoForgeHelmModel')}</li>
					</ul>
					<p class="tco-total">{t('pages.pricing.tcoForgeHelmTotal')}</p>
				</div>
				<div class="tco-card tco-other">
					<h3>{t('pages.pricing.tcoCheckmarx')}</h3>
					<p class="tco-total">{t('pages.pricing.tcoCheckmarxPrice')}</p>
				</div>
			</div>
			<p class="tco-conclusion">{t('pages.pricing.tcoConclusion')}</p>
		</div>
	</section>

	<!-- Comparison Table -->
	<section class="section compare-section">
		<div class="container">
			<h2 class="section-title">{t('pages.pricing.comparisonTitle')}</h2>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>{t('pages.pricing.tableFeature')}</th>
							<th>Core</th>
							<th class="col-featured">Professional</th>
							<th>Enterprise</th>
						</tr>
					</thead>
					<tbody>
						{[
							{ feature: 'compareDeploy', core: 'compareDeployCore', pro: 'compareDeployPro', ent: 'compareDeployEnt' },
							{ feature: 'compareFrameworks', core: 'compareFrameworksCore', pro: 'compareFrameworksPro', ent: 'compareFrameworksEnt' },
							{ feature: 'compareSbom', core: 'compareSbomCore', pro: 'compareSbomPro', ent: 'compareSbomEnt' },
							{ feature: 'compareAi', core: 'compareAiCore', pro: 'compareAiPro', ent: 'compareAiEnt' },
							{ feature: 'compareLangs', core: 'compareLangsCore', pro: 'compareLangsPro', ent: 'compareLangsEnt' },
							{ feature: 'compareMigration', core: 'compareMigrationCore', pro: 'compareMigrationPro', ent: 'compareMigrationEnt' },
							{ feature: 'compareSupport', core: 'compareSupportCore', pro: 'compareSupportPro', ent: 'compareSupportEnt' },
							{ feature: 'compareSso', core: 'compareSsoCore', pro: 'compareSsoPro', ent: 'compareSsoEnt' },
							{ feature: 'compareDataQuality', core: 'compareDataQualityCore', pro: 'compareDataQualityPro', ent: 'compareDataQualityEnt' },
						].map(row => (
							<tr>
								<td class="feature-col">{t(`pages.pricing.${row.feature}`)}</td>
								<td class="center-col">{t(`pages.pricing.${row.core}`)}</td>
								<td class="center-col col-featured">{t(`pages.pricing.${row.pro}`)}</td>
								<td class="center-col">{t(`pages.pricing.${row.ent}`)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="section faq-section" id="faq">
		<div class="container">
			<h2 class="section-title">{t('pages.pricing.faqTitle')}</h2>
			<div class="faq-grid">
				{faqs.map(({ q, a }) => (
					<div class="faq-item">
						<h3>{q}</h3>
						<p set:html={a}></p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container">
			<div class="cta-box">
				<h2>{t('pages.pricing.ctaTitle')}</h2>
				<p>{t('pages.pricing.ctaSubtitle')}</p>
				<div class="cta-btns">
					<a href={getLocalizedPath('/contact', lang)} class="btn btn-primary">{t('pages.pricing.ctaButton1')}</a>
					<a href={getLocalizedPath('/contact?type=poc', lang)} class="btn btn-secondary">{t('pages.pricing.ctaButton2')}</a>
					<a href={getLocalizedPath('/get-started', lang)} class="btn btn-ghost">{t('pages.pricing.tryNow')}</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-hero {
		padding: 8rem 0 4rem;
		background: var(--bg-main);
		border-bottom: 1px solid var(--border-light);
	}

	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-secondary);
		margin-bottom: 1.25rem;
	}

	.hero-eyebrow a { color: var(--accent); text-decoration: none; font-weight: 600; }

	.page-hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text-primary);
		margin-bottom: 1rem;
		max-width: 700px;
	}

	.hero-sub {
		font-size: 1.0625rem;
		color: var(--text-secondary);
		line-height: 1.7;
		max-width: 660px;
		margin-bottom: 1.25rem;
	}

	.billing-note {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.875rem;
		color: var(--text-secondary);
		background: rgba(255,255,255,0.05);
		border: 1px solid var(--border-color);
		padding: 0.4rem 0.875rem;
		border-radius: 9999px;
	}

	.tier-note {
		margin: 1rem auto 0;
		max-width: 760px;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--text-secondary);
		text-align: center;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.section { padding: 5rem 0; }

	.section-title {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 700;
		color: var(--text-primary);
		text-align: center;
		margin-bottom: 3rem;
		letter-spacing: -0.02em;
	}

	/* Plans */
	.plans-section { background: var(--bg-section); border-bottom: 1px solid var(--border-light); }

	.plans-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		align-items: start;
	}

	.plan-card {
		position: relative;
		padding: 2.5rem 2rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.plan-featured {
		border-color: #3b82f6;
		background: linear-gradient(180deg, rgba(59,130,246,0.07) 0%, var(--bg-card) 30%);
		box-shadow: 0 0 0 1px rgba(59,130,246,0.3), 0 16px 48px rgba(59,130,246,0.15);
	}

	.plan-popular-badge {
		position: absolute;
		top: -0.75rem;
		left: 50%;
		transform: translateX(-50%);
		background: var(--cta-primary);
		color: white;
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.2rem 1rem;
		border-radius: 9999px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		white-space: nowrap;
	}

	.plan-tag {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		background: rgba(59,130,246,0.12);
		border: 1px solid rgba(59,130,246,0.25);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		margin-bottom: 0.5rem;
	}

	.plan-header h2 {
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.375rem;
	}

	.platform-fee-alt { display: block; font-size: 0.75rem; margin-top: 0.25rem; opacity: 0.85; }

	.formula-section { border-bottom: 1px solid var(--border-light); }
	.formula-box {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		text-align: center;
	}
	.formula-box h2 { font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem; }
	.formula-expr {
		font-family: monospace;
		font-size: 1rem;
		color: var(--accent);
		background: rgba(59,130,246,0.08);
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		margin-bottom: 1rem;
	}
	.formula-example { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }

	.currency-section, .competitor-section { border-bottom: 1px solid var(--border-light); }
	.currency-table { font-size: 0.85rem; }

	.tco-section {
		background: var(--bg-section);
		border-bottom: 1px solid var(--border-light);
	}
	.tco-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}
	.tco-card {
		padding: 2rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
	}
	.tco-forgehelm { border-color: rgba(16,185,129,0.4); border-left: 4px solid #10b981; }
	.tco-card h3 { font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem; }
	.tco-card ul { list-style: none; padding: 0; margin: 0 0 1rem; }
	.tco-card li { font-size: 0.875rem; color: var(--text-secondary); padding: 0.35rem 0; line-height: 1.5; }
	.tco-total { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0; }
	.tco-conclusion {
		text-align: center;
		font-size: 0.95rem;
		color: var(--text-secondary);
		max-width: 640px;
		margin: 0 auto;
		line-height: 1.65;
	}

	@media (max-width: 768px) {
		.tco-grid { grid-template-columns: 1fr; }
	}

	.plan-desc {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	.plan-price {
		padding: 1.5rem 0;
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
	}

	.price-main {
		font-size: 2.25rem;
		font-weight: 800;
		color: var(--text-primary);
		letter-spacing: -0.03em;
		display: block;
	}

	.price-unit {
		font-size: 0.8rem;
		color: var(--text-secondary);
		display: block;
		margin-bottom: 0.75rem;
	}

	.price-alts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.price-alts span {
		font-size: 0.75rem;
		color: var(--text-secondary);
		background: rgba(255,255,255,0.05);
		border: 1px solid var(--border-color);
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
