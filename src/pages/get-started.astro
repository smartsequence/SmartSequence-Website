---
import Layout from '../layouts/Layout.astro';
import { APP_URL } from '../consts';
import { getLangFromUrl, getTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);

function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}

const trialTiers = [
	{ key: 'trialLite', priceKey: 'trialLitePrice', featured: false },
	{ key: 'trialStandard', priceKey: 'trialStandardPrice', featured: true },
	{ key: 'trialFull', priceKey: 'trialFullPrice', featured: false },
];

const trialIncludes = ['trialInclude1', 'trialInclude2', 'trialInclude3', 'trialInclude4'];
const trialFlow = ['trialFlow1', 'trialFlow2', 'trialFlow3', 'trialFlow4', 'trialFlow5'];

const enterpriseOptions = [
	{ titleKey: 'optionDemoTitle', descKey: 'optionDemoDesc', btnKey: 'optionDemoButton', href: getLocalizedPath('/contact', lang), icon: '📅' },
	{ titleKey: 'optionPoCTitle', descKey: 'optionPoCDesc', btnKey: 'optionPoCButton', href: getLocalizedPath('/contact', lang), icon: '🔬' },
	{ titleKey: 'optionPricingTitle', descKey: 'optionPricingDesc', btnKey: 'optionPricingButton', href: getLocalizedPath('/pricing', lang), icon: '💳' },
];
---

<Layout title={t('pages.getStarted.title')} description={t('pages.getStarted.description')}>
	<section class="page-hero">
		<div class="container">
			<h1>{t('pages.getStarted.heroTitle')}</h1>
			<p class="hero-sub">{t('pages.getStarted.heroSubtitle')}</p>
		</div>
	</section>

	<!-- Path A: Trial -->
	<section class="section trial-section" id="trial">
		<div class="container">
			<div class="path-header">
				<span class="path-label">A</span>
				<div>
					<h2>{t('pages.getStarted.pathATitle')}</h2>
					<p>{t('pages.getStarted.pathASubtitle')}</p>
				</div>
			</div>

			<div class="trial-layout">
				<div class="trial-includes">
					<h3>{t('pages.getStarted.trialIncludesTitle')}</h3>
					<ul>
						{trialIncludes.map(k => (
							<li>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
								{t(`pages.getStarted.${k}`)}
							</li>
						))}
					</ul>
					<div class="trial-flow">
						<h4>{t('pages.getStarted.trialFlowTitle')}</h4>
						<ol>
							{trialFlow.map(k => <li>{t(`pages.getStarted.${k}`)}</li>)}
						</ol>
					</div>
					<p class="trial-credit">{t('pages.getStarted.trialCredit')}</p>
				</div>

				<div class="trial-pricing">
					{trialTiers.map(tier => (
						<div class={`tier-card ${tier.featured ? 'tier-featured' : ''}`}>
							{tier.featured && <span class="tier-badge">{t('pages.getStarted.trialStandardBadge')}</span>}
							<h3>{t(`pages.getStarted.${tier.key}`)}</h3>
							<p class="tier-price">{t(`pages.getStarted.${tier.priceKey}`)}</p>
						</div>
					))}
					<a href={`${APP_URL}/trial`} class="trial-cta btn-primary" target="_blank" rel="noopener noreferrer">
						{t('pages.getStarted.trialCta')}
					</a>
					<p class="trial-note">{t('pages.getStarted.trialNote')}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Path B: Enterprise -->
	<section class="section enterprise-section">
		<div class="container">
			<div class="path-header">
				<span class="path-label path-label-b">B</span>
				<div>
					<h2>{t('pages.getStarted.pathBTitle')}</h2>
					<p>{t('pages.getStarted.pathBSubtitle')}</p>
				</div>
			</div>
			<div class="enterprise-grid">
				{enterpriseOptions.map(({ titleKey, descKey, btnKey, href, icon }) => (
					<div class="enterprise-card">
						<span class="ent-icon">{icon}</span>
						<h3>{t(`pages.getStarted.${titleKey}`)}</h3>
						<p>{t(`pages.getStarted.${descKey}`)}</p>
						<a href={href} class="btn-secondary">{t(`pages.getStarted.${btnKey}`)}</a>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-hero {
		padding: 8rem 0 4rem;
		background: var(--bg-main);
		text-align: center;
		border-bottom: 1px solid var(--border-light);
	}
	.page-hero h1 {
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}
	.hero-sub { font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.7; }
	.container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
	.section { padding: 5rem 0; }

	.path-header {
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}
	.path-label {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: #3b82f6;
		color: white;
		font-weight: 800;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.path-label-b { background: #10b981; }
	.path-header h2 { font-size: 1.75rem; font-weight: 800; color: var(--text-primary); margin: 0 0 0.5rem; }
	.path-header p { font-size: 1rem; color: var(--text-secondary); margin: 0; line-height: 1.6; }

	.trial-section { background: var(--bg-section); border-bottom: 1px solid var(--border-light); }
	.trial-layout {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2rem;
		align-items: start;
	}
	.trial-includes h3 { font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem; }
	.trial-includes ul { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.625rem; }
	.trial-includes li { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.9rem; color: var(--text-primary); line-height: 1.5; }
	.trial-includes svg { color: #10b981; flex-shrink: 0; margin-top: 0.15rem; }
	.trial-flow h4 { font-size: 0.9rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; }
	.trial-flow ol { margin: 0; padding-left: 1.25rem; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.7; }
	.trial-credit {
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: #60a5fa;
		background: rgba(59,130,246,0.08);
		border: 1px solid rgba(59,130,246,0.2);
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
	}

	.trial-pricing {
		padding: 2rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.tier-card {
		position: relative;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		background: var(--bg-main);
	}
	.tier-featured { border-color: #3b82f6; background: rgba(59,130,246,0.06); }
	.tier-badge {
		position: absolute;
		top: -0.5rem;
		right: 1rem;
		background: #3b82f6;
		color: white;
		font-size: 0.65rem;
		font-weight: 700;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		text-transform: uppercase;
	}
	.tier-card h3 { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem; }
	.tier-price { font-size: 1.25rem; font-weight: 800; color: #60a5fa; margin: 0; }
	.trial-cta { display: block; text-align: center; padding: 1rem; border-radius: 0.625rem; font-weight: 700; text-decoration: none; margin-top: 0.5rem; }
	.btn-primary { background: #3b82f6; color: white; }
	.btn-primary:hover { background: #2563eb; }
	.trial-note { font-size: 0.78rem; color: var(--text-secondary); text-align: center; margin: 0; font-style: italic; }

	.enterprise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.enterprise-card {
		padding: 2rem 1.5rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.ent-icon { font-size: 2rem; }
	.enterprise-card h3 { font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin: 0; }
	.enterprise-card p { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6; flex: 1; margin: 0; }
	.btn-secondary {
		display: block;
		text-align: center;
		padding: 0.75rem;
		border-radius: 0.5rem;
		border: 1px solid var(--border-color);
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.875rem;
	}
	.btn-secondary:hover { border-color: #3b82f6; color: #3b82f6; }

	@media (max-width: 900px) {
		.trial-layout { grid-template-columns: 1fr; }
		.enterprise-grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 768px) { .page-hero { padding: 6rem 0 3rem; } }
</style>
