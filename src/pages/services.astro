---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, getTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);

function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}

const serviceKeys = ['s1', 's2', 's3'];
const statKeys = ['stat1', 'stat2', 'stat3', 'stat4'];
const stepKeys = ['step1', 'step2', 'step3', 'step4', 'step5'];
const byolStepKeys = ['byolStep1', 'byolStep2', 'byolStep3', 'byolStep4', 'byolStep5'];
const howKeys = ['h1', 'h2', 'h3'];
---

<Layout title={t('pages.services.title')} description={t('pages.services.description')}>
	<!-- Hero -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-eyebrow">
				<a href={getLocalizedPath('/', lang)}>{t('common.studioCrumb')}</a>
				<span>›</span>
				<span>{t('pages.services.heroTitle')}</span>
			</div>
			<h1>{t('pages.services.heroTitle')}</h1>
			<p class="hero-sub">{t('pages.services.heroSubtitle')}</p>
		</div>
	</section>

	<!-- BYOL deployment -->
	<section class="section case-section">
		<div class="container">
			<div class="case-head">
				<span class="case-label">{t('pages.services.byolLabel')}</span>
				<h2>{t('pages.services.byolTitle')}</h2>
			</div>
			<p class="case-intro">{t('pages.services.byolIntro')}</p>
			<ol class="pipeline">
				{byolStepKeys.map((key, i) => (
					<li class="step">
						<span class="step-num">{i + 1}</span>
						<span class="step-body">
							<strong>{t(`pages.services.${key}Title`)}</strong>
							<span>{t(`pages.services.${key}Text`)}</span>
						</span>
					</li>
				))}
			</ol>
			<p class="case-note">{t('pages.services.byolNote')}</p>
		</div>
	</section>

	<!-- Case study -->
	<section class="section case-section">
		<div class="container">
			<p class="case-bridge">{t('pages.services.caseBridge')}</p>
			<div class="case-head">
				<span class="case-label">{t('pages.services.caseLabel')}</span>
				<h2>{t('pages.services.caseTitle')}</h2>
			</div>
			<p class="case-intro">{t('pages.services.caseIntro')}</p>
			<div class="stat-row">
				{statKeys.map((key) => (
					<div class="stat">
						<span class="stat-value">{t(`pages.services.${key}Value`)}</span>
						<span class="stat-label">{t(`pages.services.${key}Label`)}</span>
					</div>
				))}
			</div>
			<h3 class="pipeline-title">{t('pages.services.pipelineTitle')}</h3>
			<ol class="pipeline">
				{stepKeys.map((key, i) => (
					<li class="step">
						<span class="step-num">{i + 1}</span>
						<span class="step-body">
							<strong>{t(`pages.services.${key}Title`)}</strong>
							<span>{t(`pages.services.${key}Text`)}</span>
						</span>
					</li>
				))}
			</ol>
			<p class="case-note">{t('pages.services.caseNote')}</p>
		</div>
	</section>

	<!-- Services -->
	<section class="section services-section">
		<div class="container">
			<h2 class="section-title">{t('pages.services.servicesTitle')}</h2>
			<div class="service-grid">
				{serviceKeys.map((key) => (
					<div class="service-card">
						<h3>{t(`pages.services.${key}Title`)}</h3>
						<p>{t(`pages.services.${key}Text`)}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- How we work -->
	<section class="section how-section">
		<div class="container">
			<h2 class="section-title">{t('pages.services.howTitle')}</h2>
			<div class="how-grid">
				{howKeys.map((key) => (
					<div class="how-card">
						<h3>{t(`pages.services.${key}Title`)}</h3>
						<p>{t(`pages.services.${key}Text`)}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Billing + CTA -->
	<section class="section cta-section">
		<div class="container">
			<div class="cta-box">
				<h2>{t('pages.services.billingTitle')}</h2>
				<p class="billing-text">{t('pages.services.billingText')}</p>
				<p class="cta-lead">{t('pages.services.ctaTitle')}</p>
				<a href={getLocalizedPath('/contact', lang)} class="btn btn-primary">{t('pages.services.ctaButton')}</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
	.section { padding: 5rem 0; }

	.page-hero {
		padding: 8rem 0 4rem;
		background: var(--bg-main);
		border-bottom: 1px solid var(--border-light);
	}

	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
	}

	.hero-eyebrow a { color: var(--accent); text-decoration: none; font-weight: 600; }

	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text-primary);
		margin-bottom: 1rem;
		max-width: 700px;
	}

	.hero-sub {
		font-size: 1.0625rem;
		color: var(--text-secondary);
		line-height: 1.75;
		max-width: 720px;
	}

	.section-title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		color: var(--text-primary);
		text-align: center;
		margin-bottom: 3rem;
		letter-spacing: -0.02em;
	}

	/* 案例 */
	.case-section { border-bottom: 1px solid var(--border-light); }

	.case-bridge {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin: 0 0 1.25rem;
	}

	.case-head { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }

	.case-label {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		background: var(--bg-highlight);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		padding: 0.2rem 0.7rem;
	}

	.case-head h2 {
		font-size: clamp(1.25rem, 2.5vw, 1.625rem);
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		margin: 0;
	}

	.case-intro {
		font-size: 0.9375rem;
		color: var(--text-secondary);
		line-height: 1.85;
		max-width: 820px;
		margin-bottom: 2.5rem;
	}

	.stat-row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.stat {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		padding: 1.25rem;
		text-align: center;
	}

	.stat-value {
		display: block;
		font-size: clamp(1.125rem, 2vw, 1.5rem);
		font-weight: 800;
		color: var(--accent);
		letter-spacing: -0.02em;
		margin-bottom: 0.35rem;
	}

	.stat-label { display: block; font-size: 0.8rem; color: var(--text-secondary); }

	.pipeline-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1.25rem;
	}

	.pipeline {
		list-style: none;
		padding: 0;
		margin: 0 0 1.75rem;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.75rem;
	}

	.step {
		position: relative;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-top: 3px solid var(--cta-primary);
		border-radius: 0.75rem;
		padding: 1.25rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* 步驟之間的箭頭；最後一格不畫 */
	.step:not(:last-child)::after {
		content: '›';
		position: absolute;
		right: -0.65rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 1.25rem;
		line-height: 1;
		color: var(--accent);
	}

	.step-num {
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--accent);
		letter-spacing: 0.08em;
	}

	.step-body { display: flex; flex-direction: column; gap: 0.4rem; }

	.step-body strong { font-size: 0.9rem; color: var(--text-primary); }

	.step-body span { font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.7; }

	.case-note {
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.8;
		max-width: 820px;
		margin: 0;
	}

	.services-section { background: var(--bg-section); border-bottom: 1px solid var(--border-light); }

	.service-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.service-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-top: 3px solid var(--cta-primary);
		border-radius: 0.875rem;
		padding: 2rem;
	}

	.service-card h3 {
		font-size: 1.0625rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.875rem;
		letter-spacing: -0.01em;
	}

	.service-card p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.8;
		margin: 0;
	}

	.how-section { border-bottom: 1px solid var(--border-light); }

	.how-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.how-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-left: 3px solid var(--cta-primary);
		border-radius: 0.75rem;
		padding: 1.75rem;
	}

	.how-card h3 {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.75rem;
	}

	.how-card p {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.75;
		margin: 0;
	}

	.cta-box {
		max-width: 760px;
		margin: 0 auto;
		text-align: center;
		padding: 3rem 2rem;
		background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(16,185,129,0.05));
		border: 1px solid var(--border-color);
		border-radius: 1rem;
	}

	.cta-box h2 {
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}

	.billing-text {
		font-size: 0.9375rem;
		color: var(--text-secondary);
		line-height: 1.8;
		margin-bottom: 2rem;
	}

	.cta-lead {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 1.25rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 2rem;
		border-radius: 0.5rem;
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-primary { background: var(--cta-primary); color: white; }
	.btn-primary:hover { background: var(--cta-hover); transform: translateY(-1px); }

	@media (max-width: 1100px) {
		.pipeline { grid-template-columns: 1fr; }
		.step:not(:last-child)::after { content: none; }
		.step { flex-direction: row; align-items: flex-start; gap: 0.75rem; }
	}

	@media (max-width: 900px) {
		.service-grid, .how-grid { grid-template-columns: 1fr; }
		.stat-row { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 768px) {
		.page-hero { padding: 6rem 0 3rem; }
		.section { padding: 3.5rem 0; }
	}
</style>
