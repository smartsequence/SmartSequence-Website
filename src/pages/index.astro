---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, STUDIO_TAX_ID } from '../consts';
import { getLangFromUrl, getTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);

function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}

const modules = [
	{ icon: '📋', key: 'm1', color: '#3b82f6' },
	{ icon: '📦', key: 'm2', color: '#8b5cf6' },
	{ icon: '📊', key: 'm3', color: '#06b6d4' },
	{ icon: '🎯', key: 'm4', color: '#f59e0b' },
	{ icon: '🤖', key: 'm5', color: '#10b981' },
	{ icon: '🔄', key: 'm6', color: '#ef4444' },
	{ icon: '🗄️', key: 'm7', color: '#6366f1' },
];

const deployments = [
	{ key: 'd1', icon: '☁️' },
	{ key: 'd2', icon: '⚡', highlight: true },
	{ key: 'd3', icon: '🏢' },
	{ key: 'd4', icon: '🔒' },
];

const industries = [
	{ key: 'i1', icon: '🏦' },
	{ key: 'i2', icon: '🏛️' },
	{ key: 'i3', icon: '🏥' },
	{ key: 'i4', icon: '🏭' },
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- Hero Section -->
	<section class="hero">
		<div class="hero-bg"></div>
		<div class="container">
			<div class="hero-content">
				<div class="hero-badge">
					<span class="badge-dot"></span>
					{t('hero.badge')}
				</div>
				<h1>
					{t('hero.title')}
					<span class="hero-gradient">{t('hero.tagline')}</span>
				</h1>
				<p class="hero-subtitle">{t('hero.subtitle')}</p>
				<div class="hero-cta">
					<a href={getLocalizedPath('/contact', lang)} class="btn btn-primary">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
						</svg>
						{t('hero.ctaPrimary')}
					</a>
					<a href={getLocalizedPath('/product', lang)} class="btn btn-secondary">{t('hero.ctaSecondary')}</a>
				</div>
				<!-- Framework trust bar -->
				<div class="framework-bar">
					<span class="framework-label">{t('sections.home.frameworkLabel')}</span>
					{['ISO 27001', 'SOC 2', 'GDPR', 'PCI-DSS', 'HIPAA', 'NIST CSF', 'OWASP Top 10'].map(f => (
						<span class="framework-badge">{f}</span>
					))}
					<a href={getLocalizedPath('/compliance', lang)} class="framework-more">+13 {t('sections.home.frameworkMore')} →</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Values -->
	<section class="section core-values">
		<div class="container">
			<h2 class="section-title">{t('sections.coreValues.title')}</h2>
			<div class="values-grid">
				{(['v1', 'v2', 'v3'] as const).map((v, i) => (
					<div class={`value-card ${i === 1 ? 'value-featured' : ''}`}>
						<div class="value-icon-wrap">
							{i === 0 && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>}
							{i === 1 && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
							{i === 2 && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>}
						</div>
						<h3>{t(`sections.coreValues.${v}.title`)}</h3>
						<p class="value-subtitle">{t(`sections.coreValues.${v}.subtitle`)}</p>
						<p class="value-desc">{t(`sections.coreValues.${v}.description`)}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Product Modules -->
	<section class="section modules-section">
		<div class="container">
			<h2 class="section-title">{t('sections.modules.title')}</h2>
			<p class="section-subtitle">{t('sections.modules.subtitle')}</p>
			<div class="modules-grid">
				{modules.map(({ icon, key, color }) => (
					<div class="module-card">
						<div class="module-icon" style={`background: ${color}22; color: ${color};`}>{icon}</div>
						<h3>{t(`sections.modules.${key}.title`)}</h3>
						<p>{t(`sections.modules.${key}.description`)}</p>
					</div>
				))}
			</div>
			<div class="modules-cta">
				<a href={getLocalizedPath('/product', lang)} class="btn btn-outline">
					{t('sections.home.exploreAllModules')} →
				</a>
			</div>
		</div>
	</section>

	<!-- Deployment Flexibility -->
	<section class="section deploy-section">
		<div class="container">
			<h2 class="section-title">{t('sections.deployment.title')}</h2>
			<div class="deploy-grid">
				{deployments.map(({ key, icon, highlight }) => (
					<div class={`deploy-card ${highlight ? 'deploy-featured' : ''}`}>
						{highlight && <div class="deploy-badge">{t(`sections.deployment.${key}.badge`)}</div>}
						<div class="deploy-icon">{icon}</div>
						<h3>{t(`sections.deployment.${key}.title`)}</h3>
						<p class="deploy-badge-text">{t(`sections.deployment.${key}.badge`)}</p>
						<p>{t(`sections.deployment.${key}.description`)}</p>
					</div>
				))}
			</div>
			<div class="deploy-link">
				<a href={getLocalizedPath('/architecture', lang)}>
					{t('sections.home.viewArchitectureDoc')} →
				</a>
			</div>
		</div>
	</section>

	<!-- Industries -->
	<section class="section industries-section">
		<div class="container">
			<h2 class="section-title">{t('sections.industries.title')}</h2>
			<div class="industry-grid">
				{industries.map(({ key, icon }) => (
					<div class="industry-card">
						<div class="industry-icon">{icon}</div>
						<h3>{t(`sections.industries.${key}.title`)}</h3>
						<p>{t(`sections.industries.${key}.description`)}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Trust / Security -->
	<section class="section trust-section">
		<div class="container">
			<h2 class="section-title">{t('sections.trust.title')}</h2>
			<div class="trust-grid">
				{(['item1', 'item2', 'item3'] as const).map(item => (
					<div class="trust-card">
						<h3>{t(`sections.trust.${item}.title`)}</h3>
						<p>{t(`sections.trust.${item}.description`)}</p>
					</div>
				))}
			</div>
			<p class="trust-legal">
				{t('sections.home.trustOperatedBy')}
				· {t('sections.home.trustTaxIdLabel')} {STUDIO_TAX_ID}
			</p>
		</div>
	</section>

	<!-- Competitor pricing anchor -->
	<section class="section competitor-section">
		<div class="container">
			<h2 class="section-title">{t('sections.competitor.title')}</h2>
			<p class="competitor-summary">{t('sections.competitor.summary')}</p>
			<p class="competitor-footnote">{t('sections.competitor.footnote')}</p>
			<a href={getLocalizedPath('/pricing', lang)} class="btn btn-outline">{t('common.viewPricing')}</a>
		</div>
	</section>

	<!-- Trial experience -->
	<section class="section trial-banner">
		<div class="container">
			<div class="trial-box">
				<div class="trial-content">
					<h2>{t('sections.trial.title')}</h2>
					<p>{t('sections.trial.subtitle')}</p>
					<p class="trial-credit-line">{t('sections.trial.credit')}</p>
				</div>
				<a href={getLocalizedPath('/get-started', lang)} class="btn btn-primary btn-trial">
					{t('sections.trial.cta')}
				</a>
			</div>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="section final-cta">
		<div class="container">
			<div class="cta-box">
				<h2>{t('sections.cta.title')}</h2>
				<p>{t('sections.cta.subtitle')}</p>
				<div class="cta-buttons">
					<a href={getLocalizedPath('/contact', lang)} class="btn btn-primary">{t('sections.cta.primary')}</a>
					<a href={getLocalizedPath('/pricing', lang)} class="btn btn-secondary">{t('sections.cta.secondary')}</a>
					<a href={getLocalizedPath('/get-started', lang)} class="btn btn-ghost">{t('sections.cta.trial')}</a>
					<a href={getLocalizedPath('/product', lang)} class="btn btn-ghost">{t('sections.cta.tertiary')}</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* ── Hero ── */
	.hero {
		position: relative;
		padding: 7rem 0 5rem;
		text-align: center;
		overflow: hidden;
		background: var(--bg-main);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 60% 50% at 50% -20%, rgba(59,130,246,0.15) 0%, transparent 70%),
			radial-gradient(circle at 80% 80%, rgba(16,185,129,0.08) 0%, transparent 50%);
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		max-width: 860px;
		margin: 0 auto;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 1rem;
		border: 1px solid rgba(59,130,246,0.4);
		border-radius: 9999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		background: rgba(59,130,246,0.08);
		margin-bottom: 1.5rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--cta-primary);
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	.hero h1 {
		font-size: clamp(2.25rem, 5vw, 3.75rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		margin-bottom: 1.25rem;
		color: var(--text-primary);
	}

	.hero-gradient {
		display: block;
		background: linear-gradient(135deg, #3b82f6, #10b981);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--text-secondary);
		max-width: 660px;
		margin: 0 auto 2.5rem;
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 3rem;
	}

	.framework-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
		font-size: 0.8rem;
	}

	.framework-label {
		color: var(--text-secondary);
		white-space: nowrap;
		font-weight: 500;
	}

	.framework-badge {
		padding: 0.2rem 0.65rem;
		background: rgba(255,255,255,0.05);
		border: 1px solid rgba(255,255,255,0.12);
		border-radius: 4px;
		color: var(--text-secondary);
		font-family: monospace;
		font-size: 0.76rem;
	}

	.framework-more {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.8rem;
		white-space: nowrap;
	}

	/* ── Buttons ── */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.875rem 2rem;
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
		transition: all 0.2s ease;
		border: 2px solid transparent;
	}

	.btn-primary {
		background: var(--cta-primary);
		color: white;
		box-shadow: 0 4px 20px rgba(59,130,246,0.35);
	}

	.btn-primary:hover {
		background: var(--cta-hover);
		transform: translateY(-2px);
		box-shadow: 0 8px 28px rgba(59,130,246,0.45);
	}

	.btn-secondary {
		background: transparent;
		color: var(--text-primary);
		border-color: var(--border-color);
	}

	.btn-secondary:hover {
		border-color: #3b82f6;
		color: var(--accent);
	}

	.btn-ghost {
		background: transparent;
		color: var(--text-secondary);
		border-color: transparent;
	}

	.btn-ghost:hover {
		color: var(--text-primary);
		background: rgba(255,255,255,0.05);
	}

	.btn-outline {
		display: inline-block;
		padding: 0.75rem 1.75rem;
		border: 1.5px solid rgba(59,130,246,0.5);
		color: var(--accent);
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.2s;
	}

	.btn-outline:hover {
		background: rgba(59,130,246,0.1);
	}

	/* ── Section shared ── */
	.section {
		padding: 5rem 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.section-title {
		text-align: center;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}

	.section-subtitle {
		text-align: center;
		color: var(--text-secondary);
		font-size: 1.0625rem;
		line-height: 1.65;
		max-width: 640px;
		margin: 0 auto 3rem;
	}

	/* ── Core Values ── */
	.core-values {
		background: var(--bg-section);
		border-top: 1px solid var(--border-light);
		border-bottom: 1px solid var(--border-light);
	}

	.core-values .section-title {
		margin-bottom: 3rem;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.value-card {
		padding: 2.5rem 2rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		transition: all 0.3s;
	}

	.value-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 40px rgba(0,0,0,0.2);
		border-color: rgba(59,130,246,0.4);
	}

	.value-featured {
		border-color: rgba(59,130,246,0.5);
		background: linear-gradient(135deg, var(--bg-card), rgba(59,130,246,0.05));
	}

	.value-icon-wrap {
		width: 3.5rem;
		height: 3.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #3b82f6, #2563eb);
		border-radius: 0.75rem;
		margin-bottom: 1.25rem;
		color: white;
	}

	.value-icon-wrap svg {
		width: 1.75rem;
		height: 1.75rem;
	}

	.value-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.375rem;
	}

	.value-subtitle {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}

	.value-desc {
		color: var(--text-secondary);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	/* ── Modules ── */
	.modules-section .section-title {
		margin-bottom: 0.75rem;
	}

	.modules-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
		margin-top: 3rem;
	}

	.module-card {
		padding: 1.75rem 1.5rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.875rem;
		transition: all 0.25s;
	}

	.module-card:hover {
		border-color: rgba(59,130,246,0.4);
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0,0,0,0.15);
	}

	.module-icon {
		font-size: 1.75rem;
		width: 3rem;
		height: 3rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.625rem;
		margin-bottom: 1rem;
	}

	.module-card h3 {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.5rem;
	}

	.module-card p {
		font-size: 0.85rem;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	.modules-cta {
		text-align: center;
		margin-top: 2.5rem;
	}

	/* ── Deployment ── */
	.deploy-section {
		background: var(--bg-section);
		border-top: 1px solid var(--border-light);
		border-bottom: 1px solid var(--border-light);
	}

	.deploy-section .section-title {
		margin-bottom: 3rem;
	}

	.deploy-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}

	.deploy-card {
		position: relative;
		padding: 2rem 1.5rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.875rem;
		transition: all 0.25s;
	}

	.deploy-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0,0,0,0.2);
	}

	.deploy-featured {
		border-color: #3b82f6;
		background: linear-gradient(135deg, var(--bg-card), rgba(59,130,246,0.07));
	}

	.deploy-badge {
		position: absolute;
		top: -0.75rem;
		left: 50%;
		transform: translateX(-50%);
		background: var(--cta-primary);
		color: white;
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.2rem 0.75rem;
		border-radius: 9999px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
	}

	.deploy-icon {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.deploy-card h3 {
		font-size: 1.0625rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.375rem;
	}

	.deploy-badge-text {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 0.625rem;
	}

	.deploy-card p:last-child {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.deploy-link {
		text-align: center;
		margin-top: 2.5rem;
	}

	.deploy-link a {
		color: var(--accent);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.deploy-link a:hover {
		text-decoration: underline;
	}

	/* ── Industries ── */
	.industries-section .section-title {
		margin-bottom: 3rem;
	}

	.industry-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}

	.industry-card {
		padding: 2rem 1.5rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.875rem;
		transition: all 0.25s;
		text-align: center;
	}

	.industry-card:hover {
