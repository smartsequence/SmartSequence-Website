---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL } from '../consts';
import { getLangFromUrl, getTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);

function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}
// 送出後由 Web3Forms 導回本頁（依語系），帶 ?sent=1 以顯示成功訊息
// getLocalizedPath 對預設語系不帶尾斜線、對其他語系帶，故先正規化再補 '/?sent=1'
const successUrl = new URL(getLocalizedPath('/contact', lang).replace(/\/+$/, '') + '/?sent=1', Astro.site).toString();
---

<Layout title={t('pages.contact.title')} description={t('pages.contact.description')}>
	<!-- Hero -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-eyebrow">
				<a href={getLocalizedPath('/', lang)}>{t('common.studioCrumb')}</a>
				<span>›</span>
				<span>{t('nav.contact')}</span>
			</div>
			<h1>{t('pages.contact.heroTitle')}</h1>
			<p class="hero-sub">{t('pages.contact.heroSubtitle')}</p>
		</div>
	</section>

	<!-- Form + Info -->
	<section class="section form-section">
		<div class="container form-layout">

			<!-- Contact Form -->
			<div class="form-wrap">
				<h2>{t('pages.contact.formTitle')}</h2>
				<p class="form-desc">{t('pages.contact.formDesc')}</p>

				<div class="form-success" id="form-success" role="status" hidden>
					<strong>{t('pages.contact.sentTitle')}</strong>
					<p>{t('pages.contact.sentText')}</p>
				</div>

				<form
					action="https://api.web3forms.com/submit"
					method="POST"
					class="contact-form"
				>
					<input type="hidden" name="access_key" value="ff66a317-834b-4254-97ac-5aa7d1491025" />
					<input type="hidden" name="subject" value="ForgeHelm Enterprise Inquiry" />
					<input type="hidden" name="from_name" value="ForgeHelm Website" />
					<input type="hidden" name="redirect" value={successUrl} />
					<input type="checkbox" name="botcheck" style="display:none" />

					<div class="form-row">
						<div class="form-group">
							<label for="name">{t('pages.contact.nameLabel')} *</label>
							<input type="text" id="name" name="name" required placeholder={t('pages.contact.namePlaceholder')} />
						</div>
						<div class="form-group">
							<label for="email">{t('pages.contact.emailLabel')} *</label>
							<input type="email" id="email" name="email" required placeholder={t('pages.contact.emailPlaceholder')} />
						</div>
					</div>

					<div class="form-row">
						<div class="form-group">
							<label for="company">{t('pages.contact.companyLabel')} *</label>
							<input type="text" id="company" name="company" required placeholder={t('pages.contact.companyPlaceholder')} />
						</div>
						<div class="form-group">
							<label for="title">{t('pages.contact.titleLabel')}</label>
							<input type="text" id="title" name="title" placeholder={t('pages.contact.titlePlaceholder')} />
						</div>
					</div>

					<div class="form-row">
						<div class="form-group">
							<label for="devCount">{t('pages.contact.sizeLabel')}</label>
							<input type="text" id="devCount" name="devCount" placeholder={t('pages.contact.sizePlaceholder')} />
						</div>
						<div class="form-group">
							<label for="plan">{t('pages.contact.planLabel')}</label>
							<select id="plan" name="plan_interest">
								<option value="">{t('pages.contact.planPlaceholder')}</option>
								<option value="core">{t('pages.contact.planCore')}</option>
								<option value="professional">{t('pages.contact.planPro')}</option>
								<option value="enterprise">{t('pages.contact.planEnt')}</option>
								<option value="undecided">{t('pages.contact.planUndecided')}</option>
							</select>
						</div>
					</div>

					<div class="form-row">
						<div class="form-group full-width">
							<label for="subject">{t('pages.contact.subjectLabel')} *</label>
							<select id="subject" name="subject_type" required>
								<option value="">{t('pages.contact.subjectPlaceholder')}</option>
								<option value="demo">{t('pages.contact.subjectDemo')}</option>
								<option value="poc">{t('pages.contact.subjectPoC')}</option>
								<option value="pricing">{t('pages.contact.subjectPricing')}</option>
								<option value="arch">{t('pages.contact.subjectArch')}</option>
								<option value="compliance">{t('pages.contact.subjectCompliance')}</option>
								<option value="other">{t('pages.contact.subjectOther')}</option>
							</select>
						</div>
					</div>

					<div class="form-group full-width">
						<label for="message">{t('pages.contact.messageLabel')}</label>
						<textarea id="message" name="message" rows="5" placeholder={t('pages.contact.messagePlaceholder')}></textarea>
					</div>

					<button type="submit" class="submit-btn">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
						</svg>
						{t('pages.contact.submitButton')}
					</button>
				</form>
			</div>

			<!-- Contact Info Sidebar -->
			<div class="info-wrap">
				<div class="info-card">
					<h3>{t('pages.contact.contactInfoTitle')}</h3>

					<div class="info-item">
						<div class="info-icon">✉</div>
						<div>
							<p class="info-label">{t('pages.contact.emailTitle')}</p>
							<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
							<p class="info-desc">{t('pages.contact.emailDesc')}</p>
						</div>
					</div>

					<div class="info-item">
						<div class="info-icon">⏱</div>
						<div>
							<p class="info-label">{t('pages.contact.responseTimeLabel')}</p>
							<p class="info-value">{t('pages.contact.responseTime')}</p>
						</div>
					</div>

					<div class="info-divider"></div>

					<div class="quick-links">
						<p class="quick-label">{t('pages.contact.usefulResources')}</p>
						<a href={getLocalizedPath('/architecture', lang)}>
							→ {t('pages.contact.linkArchitecture')}
						</a>
						<a href={getLocalizedPath('/compliance', lang)}>
							→ {t('pages.contact.linkCompliance')}
						</a>
						<a href={getLocalizedPath('/pricing', lang)}>
							→ {t('pages.contact.linkPricing')}
						</a>
						<a href={getLocalizedPath('/pricing#faq', lang)}>
							→ {t('pages.contact.linkFaq')}
						</a>
					</div>
				</div>
			</div>

		</div>
	</section>
</Layout>

<style>
	.page-hero {
		padding: 8rem 0 4rem;
		background: var(--bg-main);
		border-bottom: 1px solid var(--border-light);
	}

	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-secondary);
		margin-bottom: 1.25rem;
	}

	.hero-eyebrow a { color: var(--accent); text-decoration: none; font-weight: 600; }

	.page-hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--text-primary);
		margin-bottom: 1rem;
		max-width: 600px;
	}

	.hero-sub {
		font-size: 1.0625rem;
		color: var(--text-secondary);
		line-height: 1.7;
		max-width: 580px;
	}

	.container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
	.section { padding: 5rem 0; }

	.form-layout {
		display: grid;
		grid-template-columns: 1fr 360px;
		gap: 3rem;
		align-items: start;
	}

	/* Form */
	.form-wrap h2 {
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.5rem;
		letter-spacing: -0.02em;
	}

	.form-desc {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-bottom: 2rem;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-group.full-width { grid-column: 1 / -1; }

	label {
		font-size: 0.825rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	input, select, textarea {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
		font-size: 0.9375rem;
		color: var(--text-primary);
		transition: border-color 0.2s;
		font-family: inherit;
		width: 100%;
		box-sizing: border-box;
	}

	input::placeholder, textarea::placeholder {
		color: var(--text-secondary);
		opacity: 0.6;
	}

	input:focus, select:focus, textarea:focus {
		outline: none;
		border-color: #3b82f6;
		box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
	}

	select {
		cursor: pointer;
		appearance: auto;
	}

	textarea { resize: vertical; min-height: 120px; }

	.form-success {
		margin-bottom: 2rem;
		padding: 1rem 1.25rem;
		border: 1px solid rgba(16, 185, 129, 0.45);
		border-left: 4px solid var(--cta-success);
		border-radius: 0.5rem;
		background: rgba(16, 185, 129, 0.08);
	}

	.form-success strong {
		display: block;
		color: var(--text-primary);
		font-size: 0.95rem;
		margin-bottom: 0.35rem;
	}

	.form-success p {
		margin: 0;
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.form-success[hidden] { display: none; }

	.submit-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.875rem 2rem;
		background: var(--cta-primary);
		color: white;
		border: none;
		border-radius: 0.5rem;
		font-size: 0.9375rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.2s;
		align-self: flex-start;
	}

	.submit-btn:hover {
		background: var(--cta-hover);
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(59,130,246,0.3);
	}

	/* Info Card */
	.info-wrap { position: sticky; top: 6rem; }

	.info-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 2rem;
	}

	.info-card h3 {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1.5rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.info-item {
		display: flex;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.info-icon {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.5rem;
		background: rgba(59,130,246,0.1);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1rem;
		flex-shrink: 0;
	}

	.info-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
	}

	.info-item a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		display: block;
	}

	.info-item a:hover { text-decoration: underline; }

	.info-value {
		font-size: 0.875rem;
		color: var(--text-primary);
	}

	.info-desc {
		font-size: 0.8rem;
		color: var(--text-secondary);
		margin-top: 0.25rem;
	}

	.info-divider {
		height: 1px;
		background: var(--border-light);
		margin: 1.5rem 0;
	}

	.quick-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.quick-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.375rem;
	}

	.quick-links a {
		color: var(--accent);
		text-decoration: none;
		font-size: 0.875rem;
		transition: color 0.2s;
	}

	.quick-links a:hover { color: white; }

	@media (max-width: 1024px) {
		.form-layout { grid-template-columns: 1fr; }
		.info-wrap { position: static; }
	}

	@media (max-width: 768px) {
		.page-hero { padding: 6rem 0 3rem; }
		.form-row { grid-template-columns: 1fr; }
		.section { padding: 3.5rem 0; }
	}
</style>

<script>
	// 送出成功後 Web3Forms 會導回 ?sent=1；顯示成功訊息並把參數從網址移除，
	// 以免使用者重新整理時又看到一次。
	if (new URLSearchParams(location.search).has('sent')) {
		const box = document.getElementById('form-success');
		if (box) {
			box.hidden = false;
			box.scrollIntoView({ block: 'center', behavior: 'smooth' });
		}
		history.replaceState(null, '', location.pathname);
	}
</script>
