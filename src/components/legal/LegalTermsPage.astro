---
import Layout from '../../layouts/Layout.astro';
import { STUDIO_NAME, STUDIO_TAX_ID, CONTACT_EMAIL } from '../../consts';

function fmt(text: string): string {
	return text
		.replaceAll('{studioName}', STUDIO_NAME)
		.replaceAll('{studioNameEn}', 'Smart Sequence Tech')
		.replaceAll('{taxId}', STUDIO_TAX_ID)
		.replaceAll('{email}', CONTACT_EMAIL);
}
import { getLangFromUrl, getTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang);
const doc = translations.pages?.legal?.terms;

if (!doc?.sections) {
  throw new Error(`Missing pages.legal.terms for locale: ${lang}`);
}

const sections = doc.sections as Array<{
  heading: string;
  paragraphs?: string[];
  bullets?: string[];
}>;
---

<Layout title={doc.title} description={doc.description}>
	<div class="legal-page">
		<div class="container">
			<h1>
				{doc.h1}
				{doc.h1Secondary && <span lang="en">{doc.h1Secondary}</span>}
			</h1>
			<p class="last-updated">{doc.lastUpdated}</p>

			<div class="content">
				{sections.map((section) => (
					<section>
						<h2>{section.heading}</h2>
						{section.paragraphs?.map((p) => (
							<p set:html={fmt(p)} />
						))}
						{section.bullets && (
							<ul>
								{section.bullets.map((item) => (
									<li set:html={fmt(item)} />
								))}
							</ul>
						)}
					</section>
				))}
			</div>
		</div>
	</div>
</Layout>

<style>
	.legal-page {
		padding: 3rem 0;
		background: var(--bg-main);
	}

	.container {
		max-width: 900px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	h1 {
		font-size: 2.5rem;
		color: var(--gray-dark);
		margin-bottom: 0.5rem;
	}

	h1 span {
		display: block;
		font-size: 1.125rem;
		font-weight: 400;
		color: var(--gray-medium);
		margin-top: 0.5rem;
	}

	.last-updated {
		color: var(--gray-medium);
		font-size: 0.875rem;
		margin-bottom: 3rem;
	}

	.content {
		background: var(--bg-card);
		padding: 3rem;
		border-radius: 1rem;
		border: 1px solid var(--border-color);
		box-shadow: var(--shadow-sm);
	}

	section {
		margin-bottom: 2.5rem;
	}

	section:last-child {
		margin-bottom: 0;
	}

	h2 {
		font-size: 1.5rem;
		color: var(--primary);
		margin-bottom: 1rem;
	}

	p {
		color: var(--gray-medium);
		line-height: 1.75;
		margin-bottom: 1rem;
	}

	ul {
		list-style: disc;
		padding-left: 1.5rem;
		margin: 0;
	}

	li {
		color: var(--gray-medium);
		line-height: 1.75;
		margin-bottom: 0.5rem;
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 2rem;
		}

		.content {
			padding: 2rem 1.5rem;
		}

		h2 {
			font-size: 1.25rem;
		}
	}
</style>
