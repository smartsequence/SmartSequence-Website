---
import { BRAND_NAME } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getTranslations, getLocalizedPath } from '../i18n/utils';
import type { Language } from '../i18n/languages';

interface Props {
	lang: Language;
	currentPath: string;
}

const { lang, currentPath } = Astro.props;
const translations = await getTranslations(lang);

// 翻譯函式
function t(key: string): string {
	const keys = key.split('.');
	let value: any = translations;
	for (const k of keys) {
		value = value?.[k];
		if (value === undefined) return key;
	}
	return value || key;
}
---

<header>
	<nav class="container">
		<div class="logo">
			<a href={getLocalizedPath('/', lang)}>
				<span class="logo-text">{BRAND_NAME}</span>
			</a>
		</div>
		
		<div class="nav-panel" id="primary-nav">
			<div class="nav-links">
				<div class="nav-item-dropdown">
					<a href={getLocalizedPath('/product', lang)} class="nav-link">{t('nav.product')}</a>
					<div class="dropdown-menu">
						<a href={getLocalizedPath('/architecture', lang)}>
							<span class="dropdown-icon">⬡</span>
							<span>
								<strong>{t('common.learnArchitecture')}</strong>
								<small>{t('nav.architectureSub')}</small>
							</span>
						</a>
						<a href={getLocalizedPath('/compliance', lang)}>
							<span class="dropdown-icon">✓</span>
							<span>
								<strong>{t('common.learnCompliance')}</strong>
								<small>{t('nav.complianceSub')}</small>
							</span>
						</a>
					</div>
				</div>
				<HeaderLink href={getLocalizedPath('/pricing', lang)}>{t('nav.pricing')}</HeaderLink>
				<HeaderLink href={getLocalizedPath('/use-cases', lang)}>{t('nav.useCases')}</HeaderLink>
				<HeaderLink href={getLocalizedPath('/about', lang)}>{t('nav.about')}</HeaderLink>
				<HeaderLink href={getLocalizedPath('/contact', lang)}>{t('nav.contact')}</HeaderLink>
			</div>
		
			<div class="header-actions">
				<LanguageSwitcher currentLang={lang} currentPath={currentPath} />
				<button id="theme-toggle" class="theme-toggle" aria-label={t('nav.themeToggleLabel')}>
					<svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
					</svg>
					<svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
					</svg>
				</button>
				<a href={getLocalizedPath('/get-started', lang)} class="btn-try">{t('nav.tryNow')}</a>
				<a href={getLocalizedPath('/contact', lang)} class="btn-primary">{t('nav.requestDemo')}</a>
			</div>
		</div>

		<button
			id="nav-toggle"
			class="nav-toggle"
			type="button"
			aria-controls="primary-nav"
			aria-expanded="false"
			aria-label={t('nav.menuLabel')}
		>
			<svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
			</svg>
			<svg class="close-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
			</svg>
		</button>
	</nav>
</header>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	
	if (themeToggle) {
		themeToggle.addEventListener('click', () => {
			if (typeof window.toggleTheme === 'function') {
				window.toggleTheme();
				// Update button icon state
				updateThemeIcon();
			}
		});
	}
	
	function updateThemeIcon() {
		const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
		const themeToggle = document.getElementById('theme-toggle');
		if (themeToggle) {
			if (currentTheme === 'dark') {
				themeToggle.classList.remove('light');
				themeToggle.classList.add('dark');
			} else {
				themeToggle.classList.remove('dark');
				themeToggle.classList.add('light');
			}
		}
	}
	
	// Initialize icon state
	updateThemeIcon();

	// 行動版導覽選單開合
	const header = document.querySelector('header');
	const navToggle = document.getElementById('nav-toggle');
	const desktopQuery = window.matchMedia('(min-width: 1201px)');

	function closeNav() {
		header?.classList.remove('nav-open');
		navToggle?.setAttribute('aria-expanded', 'false');
	}

	if (header && navToggle) {
		navToggle.addEventListener('click', () => {
			const open = header.classList.toggle('nav-open');
			navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		});

		// 點選單內任一連結後收合
		document.getElementById('primary-nav')?.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) closeNav();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeNav();
		});

		// 視窗放大回桌機寬度時，清掉展開狀態，避免面板卡住
		desktopQuery.addEventListener('change', (event) => {
			if (event.matches) closeNav();
		});
	}
</script>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: var(--bg-footer);
		backdrop-filter: blur(10px);
		box-shadow: var(--shadow-md);
		border-bottom: 1px solid var(--border-light);
	}

	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 5rem;
		gap: 2rem;
	}

	.logo a {
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.logo-text {
		font-size: 1.125rem;
		font-weight: 700;
		color: white;
		white-space: nowrap;
		letter-spacing: -0.01em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 2.5rem;
		flex: 1;
		justify-content: center;
	}

	.nav-links :global(a) {
		color: rgba(255, 255, 255, 0.9);
		font-weight: 500;
		font-size: 0.9375rem;
		transition: all 0.2s ease;
		text-decoration: none;
	}

	.nav-links :global(a:hover) {
		color: white;
	}

	/* Product dropdown */
	.nav-item-dropdown {
		position: relative;
	}

	.nav-link {
		color: rgba(255, 255, 255, 0.9);
		font-weight: 500;
		font-size: 0.9375rem;
		text-decoration: none;
		transition: color 0.2s ease;
		cursor: pointer;
	}

	.nav-link:hover {
		color: white;
	}

	.dropdown-menu {
		display: none;
		position: absolute;
		top: calc(100% + 0.75rem);
		left: 50%;
		transform: translateX(-50%);
		background: #1e293b;
		border: 1px solid rgba(59, 130, 246, 0.3);
		border-radius: 0.75rem;
		padding: 0.75rem;
		min-width: 280px;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
		z-index: 100;
		flex-direction: column;
		gap: 0.25rem;
	}

	.nav-item-dropdown:hover .dropdown-menu {
		display: flex;
	}

	.dropdown-menu a {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.75rem;
		border-radius: 0.5rem;
		text-decoration: none;
		color: rgba(255, 255, 255, 0.85);
		transition: background 0.2s ease;
	}

	.dropdown-menu a:hover {
		background: rgba(59, 130, 246, 0.15);
		color: white;
	}

	.dropdown-icon {
		font-size: 1.125rem;
		flex-shrink: 0;
		margin-top: 0.125rem;
		color: #3b82f6;
	}

	.dropdown-menu span {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.dropdown-menu strong {
		font-size: 0.9rem;
		font-weight: 600;
	}

	.dropdown-menu small {
		font-size: 0.775rem;
		color: #94a3b8;
	}

	/* 桌機：面板本身不參與版面，讓 .nav-links 與 .header-actions 直接當 nav 的 flex 子項 */
	.nav-panel {
		display: contents;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.nav-toggle {
		display: none;
		width: 2.75rem;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: var(--radius-md);
		color: white;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.nav-toggle:hover {
		background: rgba(255, 255, 255, 0.15);
	}

	.nav-toggle svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	.nav-toggle .close-icon,
	header.nav-open .nav-toggle .menu-icon {
		display: none;
	}

	header.nav-open .nav-toggle .close-icon {
		display: block;
	}

	.theme-toggle {
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: var(--radius-md);
		cursor: pointer;
		transition: all 0.2s ease;
		position: relative;
	}

	.theme-toggle:hover {
		background: rgba(255, 255, 255, 0.15);
		transform: translateY(-1px);
	}

	.theme-toggle svg {
		width: 1.25rem;
		height: 1.25rem;
		color: white;
		transition: all 0.3s ease;
		position: absolute;
	}

	.theme-toggle.dark .sun-icon {
		opacity: 0;
		transform: rotate(180deg) scale(0);
	}

	.theme-toggle.dark .moon-icon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.theme-toggle.light .sun-icon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.theme-toggle.light .moon-icon {
		opacity: 0;
		transform: rotate(-180deg) scale(0);
	}

	.btn-try {
		display: inline-block;
		padding: 0.75rem 1.25rem;
		background: transparent;
		color: var(--text-primary);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.875rem;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.btn-try:hover {
		border-color: #10b981;
		color: #10b981;
	}

	.btn-primary {
		display: inline-block;
		padding: 0.75rem 1.75rem;
		background: var(--cta-primary);
		color: white;
		border-radius: var(--radius-md);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
		transition: all 0.2s ease;
		white-space: nowrap;
		box-shadow: var(--shadow-sm);
	}

	.btn-primary:hover {
		background: var(--cta-hover);
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
	}

	/* 響應式設計
	   斷點取 1200px：載入字型後逐 10px 實測桌機列開始在連結內換行的寬度——
	   de 1180px、zh-TW 1130px、ja 與 en 至 900px 仍不換行。取最寬的 de 再留 20px 餘裕。
	   換行會把固定高度的 header 撐破而蓋住內容，故 1200px 以下改為漢堡選單，
	   header 維持固定高度，與 Layout 的 body padding-top 對齊。 */
	@media (max-width: 1200px) {
		.nav-toggle {
			display: inline-flex;
		}

		/* 面板改為 header 下方的展開層；header 為 position: fixed，故為其定位基準 */
		.nav-panel {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 1.25rem;
			padding: 1.25rem 1.5rem 1.5rem;
			background: var(--bg-footer);
			border-bottom: 1px solid var(--border-light);
			box-shadow: var(--shadow-md);
			max-height: calc(100dvh - 5rem);
			overflow-y: auto;
		}

		header.nav-open .nav-panel {
			display: flex;
		}

		.nav-links {
			flex: none;
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			gap: 0.25rem;
		}

		.nav-links :global(a),
		.nav-link {
			display: block;
			padding: 0.625rem 0;
			font-size: 1rem;
		}

		/* 觸控裝置沒有 hover，子項目直接攤平顯示 */
		.nav-item-dropdown {
			position: static;
		}

		.dropdown-menu {
			display: flex;
			position: static;
			transform: none;
			min-width: 0;
			margin: 0 0 0.5rem 0.75rem;
			padding: 0;
			background: transparent;
			border: none;
			box-shadow: none;
		}

		.dropdown-menu a {
			padding: 0.5rem;
		}

		.header-actions {
			flex-direction: column;
			align-items: stretch;
			gap: 0.75rem;
			padding-top: 1rem;
			border-top: 1px solid var(--border-light);
		}

		.btn-try,
		.btn-primary {
			text-align: center;
		}
	}

	@media (max-width: 768px) {
		/* 高度須與 Layout 的 body { padding-top: 70px } 一致，否則 header 會蓋住內容 */
		nav {
			height: 4.375rem;
			gap: 1rem;
		}

		.nav-panel {
			max-height: calc(100dvh - 4.375rem);
		}

		.logo-text {
			font-size: 1rem;
		}
	}
</style>
